# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=""

# ==============================================================================
# Firebase Configuration Note:
# All client Firebase credentials are read directly from firebase-applet-config.json.
# Environment variables below are optional overrides.
# ==============================================================================

# Firebase Web API Key
VITE_FIREBASE_API_KEY=""

# Firebase Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=""

# Google Cloud / Firebase Project ID
VITE_FIREBASE_PROJECT_ID=""

# Cloud Storage Bucket
VITE_FIREBASE_STORAGE_BUCKET=""

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Firebase Web App ID
VITE_FIREBASE_APP_ID=""

# Custom Firestore Database ID (if using a named database)
VITE_FIREBASE_DATABASE_ID=""

# Google OAuth Client ID for Web Sign-In
VITE_FIREBASE_OAUTH_CLIENT_ID=""

# Optional: Google Analytics Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional: Firebase reCAPTCHA Enterprise Site Key
VITE_FIREBASE_RECAPTCHA_SITE_KEY=""

